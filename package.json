{
  "name": "taskcontinuum",
  "productName": "Task Continuum",
  "version": "0.1.0",
  "description": "A focused desktop workbench for tasks and agent sessions",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.cjs",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "build:vscode-bridge": "npm run typecheck && node scripts/build-vscode-bridge.mjs",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.13",
    "@microsoft/dev-tunnels-connections": "1.3.56",
    "@microsoft/dev-tunnels-contracts": "1.3.56",
    "@microsoft/dev-tunnels-management": "1.3.56",
    "@vscode/codicons": "0.0.45",
    "mdast-util-to-string": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "ssh2": "1.17.0",
    "unified": "11.0.5",
    "zod": "4.3.6"
  },
  "overrides": {
    "@microsoft/dev-tunnels-connections": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ssh2": "1.15.5",
    "@types/vscode": "1.134.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vscode/vsce": "3.7.1",
    "electron": "44.0.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
